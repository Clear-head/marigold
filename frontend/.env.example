# Marigold Frontend Environment Variables
# cp .env.example .env

# --- Base URLs (Docker EXTERNAL_PORT 기준) ---
AUTH_BASE_URL=http://YOUR_SERVER_IP:8001
CHAT_BASE_URL=http://YOUR_SERVER_IP:8002
